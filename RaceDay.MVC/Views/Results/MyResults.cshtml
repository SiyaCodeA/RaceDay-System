@model List<RaceDay.MVC.ViewModels.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>
    <p class="text-muted">
        View your recorded race performance.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-outline-secondary mb-3">
        Back to Dashboard
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any recorded race results yet.
            Once an organiser records your result, it will appear here.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Event Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@result.Location</td>
                            <td>@result.CategoryName</td>
                            <td>@(result.FinishTime ?? "Not recorded")</td>
                            <td>@(result.FinishPosition?.ToString() ?? "Not recorded")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>